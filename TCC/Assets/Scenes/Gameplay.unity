--- !u!114 &789918514
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 789918512}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49fbcc110e764dd4f931fbcc40372e25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteragivel
  falas:
  - nomeFalante: "B\xEAbado 1"
    retrato: {fileID: 0}
    fala: "*hic*... Voc\xEA soube? Mais um sumiu ontem perto daquela maldita mans\xE3o.
      J\xE1 perdi as contas de quantos desapareceram nessa cidade..."
  - nomeFalante: "B\xEAbado 2"
    retrato: {fileID: 0}
    fala: "Cala a boca  logo! N\xE3o fala dessa casa em voz alta, d\xE1 azar. Ainda
      bem que trancaram aquele port\xE3o de ferro."
  - nomeFalante: "B\xEAbado 1"
    retrato: {fileID: 0}
    fala: "Trancaram nada... a guarda da delegacia confiscou a chave do port\xE3o
      depois do \xFAltimo sumi\xE7o. Eu vi ela pendurada bem no cinto dela hoje mais
      cedo."
  - nomeFalante: "B\xEAbado 2"
    retrato: {fileID: 0}
    fala: "Pois que fique l\xE1! Nem por todo o dinheiro do mundo eu chego perto
      daquela mans\xE3o \xE0 noite... Vamos embora antes que alguma coisa pegue a
      gente aqui nesse beco."
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "\"Pensamento\" A chave da mans\xE3o est\xE1 no cinto da guarda, na delegacia.
      Melhor descansar na pousada esta noite e dar um jeito de pegar essa chave amanh\xE3."
  aoTerminarConversa:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1532497957}
        m_TargetAssemblyTypeName: GameStateManager, Assembly-CSharp
        m_MethodName: MarcarBeco
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  mensagemSemMaisNada: "Eles est\xE3o b\xEAbados demais e resmungando coisas sem
    sentido sobre os desaparecidos. J\xE1 ouvi tudo o que precisava."
