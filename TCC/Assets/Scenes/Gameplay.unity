  m_GameObject: {fileID: 1138823636}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49fbcc110e764dd4f931fbcc40372e25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteragivel
  falas:
  - nomeFalante: Viajante
    retrato: {fileID: 0}
    fala: "Dizem por a\xED que quem entra naquela casa no alto da colina sai de bolso
      cheio... que o velho guardava uma fortuna trancada l\xE1 dentro."
  - nomeFalante: Morador Antigo
    retrato: {fileID: 0}
    fala: "Coisa de gente que n\xE3o conhece esta terra. Metal brilhante nunca compra
      o que mora naquelas paredes \u2014 moeda nenhuma paga a d\xEDvida daquela fam\xEDlia."
  - nomeFalante: Morador Antigo
    retrato: {fileID: 0}
    fala: "As ra\xEDzes daquela casa s\xF3 bebem do que \xE9 puro... o pre\xE7o foi
      pago em vida, muito antes de qualquer fechadura enferrujar."
  - nomeFalante: Viajante
    retrato: {fileID: 0}
    fala: "Voc\xEA fala de um jeito estranho... Melhor deixar essa conversa para
      l\xE1 antes que o jantar esfrie."
  - nomeFalante: 
    retrato: {fileID: 0}
    fala: "N\xE3o entendi uma palavra do que esses dois estavan falando... (suspira)
      parecia mais um monte de supersti\xE7\xE3o sem sentido. Melhor eu ir me deitar
      logo."
  aoTerminarConversa:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1532497957}
        m_TargetAssemblyTypeName: GameStateManager, Assembly-CSharp
        m_MethodName: MarcarConversaMesa
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  mensagemSemMaisNada: "Parece que eu n\xE3o vou conseguir mais nada."
