--- !u!114 &1691127881
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1691127879}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49fbcc110e764dd4f931fbcc40372e25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteragivel
  falas:
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "Boa noite. Acabei de chegar na cidade e preciso de um lugar para passar
      a noite... e talvez alguma informa\xE7\xE3o, se n\xE3o for inc\xF4modo."
  - nomeFalante: Atendente
    retrato: {fileID: 0}
    fala: "Seguindo reto voc\xEA d\xE1 no refeit\xF3rio; mais para dentro ficam os
      quartos. N\xE3o fique perambulando perto da colina."
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "Perto da colina? Por qu\xEA? O que tem por l\xE1? "
  - nomeFalante: Atendente
    retrato: {fileID: 0}
    fala: "N\xE3o me fa\xE7a repetir."
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "(Pensamento) Direta ao ponto... Melhor n\xE3o insistir nisso agora."
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "S\xF3 estou de passagem pela cidade. Sabe me dizer se h\xE1 algum lugar
      aberto a est\xE1 hora?"
  - nomeFalante: Atendente
    retrato: {fileID: 0}
    fala: "N\xE3o me pagam para ser guia tur\xEDstico. Coma, durma e siga seu caminho
      amanh\xE3."
  - nomeFalante: "Mercen\xE1rio"
    retrato: {fileID: 0}
    fala: "(Pensamento) Recep\xE7\xE3o calorosa... Melhor dar uma olhada nas ruas
      antes que a cidade feche de vez."
  aoTerminarConversa:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1532497957}
        m_TargetAssemblyTypeName: GameStateManager, Assembly-CSharp
        m_MethodName: MarcarAtendente
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 1691127884}
        m_TargetAssemblyTypeName: BloqueioAtendentePousada, Assembly-CSharp
        m_MethodName: LiberarCaminhos
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  mensagemSemMaisNada: "Parece que eu n\xE3o vou conseguir mais nada."
