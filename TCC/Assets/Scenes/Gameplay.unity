  nomeObjeto: Jornal velho
  tipo: 0
  textoExaminar: "AUTOS N\xBA 14-B \u2014 ARCHIVO: ...sem vest\xEDgios de combust\xE3o
    ou cinzas nos aposentos principais. O titular da propriedade permanece desaparecido;
    a \xFAnica evid\xEAncia recolhida no sal\xE3o foi um la\xE7o de c\xE2nhamo rompido
    suspenso na viga mestra, sem sinais de queda ou luta. Port\xE3o lacrado por tempo
    indeterminado."
  itemParaColetar: {fileID: 0}
  textoAoColetar: 
  aoInteragir:
    m_PersistentCalls:
      m_Calls: []
  itemNecessario: {fileID: 0}
  textoItemCorreto: 
  textoItemErrado: "Isso n\xE3o funciona aqui."
  textoDepoisDeUsado: 
  consumirItem: 1
  usoUnico: 1
  itemRecompensa: {fileID: 0}
  aoUsarItemCorreto:
    m_PersistentCalls:
      m_Calls: []
  objetoPreRequisito: {fileID: 0}
  textoPreRequisitoNaoCumprido: "Ainda n\xE3o faz sentido usar isso aqui. Preciso
    investigar outro lugar primeiro."
